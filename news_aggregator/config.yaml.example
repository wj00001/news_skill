# ============================================
# 每日新闻聚合 - 配置文件模板
# 复制为 config.yaml 并填入你的信息
# ============================================

email:
  # QQ邮箱 SMTP 配置（其他邮箱改对应服务器地址）
  smtp_host: smtp.qq.com
  smtp_port: 465
  sender: your_email@qq.com
  password: your_smtp_auth_code
  # 收件人列表（支持多人）
  recipients:
    - your_email@qq.com
    # - friend@example.com

news_sources:
  - name: 36氪
    url: https://36kr.com/feed
    max_articles: 10
  - name: 人民网-时政
    url: http://www.people.com.cn/rss/politics.xml
    max_articles: 8
  - name: 人民网-财经
    url: http://www.people.com.cn/rss/finance.xml
    max_articles: 8
  - name: 人民网-国际
    url: http://www.people.com.cn/rss/world.xml
    max_articles: 8
  - name: 新浪新闻
    url: http://rss.sina.com.cn/news/china/focus15.xml
    max_articles: 8
  - name: 新华网
    url: http://www.xinhuanet.com/politics/news_politics.xml
    max_articles: 8
  - name: 环球网
    url: http://www.huanqiu.com/rss/1.xml
    max_articles: 8

hot_search:
  enabled: true
  sources:
    - baidu
  max_items: 20

schedule:
  enabled: true
  time: "08:00"

email_subject: "每日新闻摘要 - {date}"
